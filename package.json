{
  "name": "chehrag",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Chehrag \u2014 voice-first RAG that answers from your own sources in under 200ms, entirely in the browser",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "bench": "npm --prefix web run bench",
    "calibrate": "npm --prefix web run calibrate",
    "typecheck": "npm --prefix web run typecheck",
    "deploy": "./scripts/deploy.sh",
    "deploy:web": "npm run build && npx wrangler pages deploy web/dist --project-name chehrag",
    "deploy:worker": "npm --prefix worker run deploy",
    "bench:multilingual": "npm --prefix web run bench:multilingual",
    "bench:gates": "npm --prefix web run bench:gates",
    "bench:deadline": "npm --prefix web run bench:deadline",
    "parallel-queries": "cd pipeline && ./.venv/bin/python src/parallel_queries.py --n 500",
    "bench:usersource": "npm --prefix web run bench:usersource",
    "verify:deploy": "./scripts/verify-deploy.sh",
    "keys": "./scripts/setup-keys.sh",
    "keys:check": "./scripts/check-keys.sh"
  }
}
