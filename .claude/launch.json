{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chehrag",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "web",
      "port": 5173
    },
    {
      "name": "chehrag-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "cwd": "web",
      "port": 4173
    },
    {
      "name": "chehrag-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "cwd": "worker",
      "port": 8787
    }
  ]
}
